# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by Prisma)
# For local dev: docker-compose up -d (see docker-compose.yml)
# For production: use Neon (neon.tech) free tier
DATABASE_URL="postgresql://colife:colife_pass@localhost:5433/colife_db"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Random 32-byte secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret_min_32_chars"

# ─── Firebase — Backend (Admin SDK) ────────────────────────────────────────────
# From Firebase Console → Project Settings → Service Accounts → Generate key
# The private_key contains literal \n — paste it as-is
FIREBASE_PROJECT_ID="colife-17952"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@colife-17952.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ─── Firebase — Frontend (Client SDK) ──────────────────────────────────────────
# From Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyA98hrFzVL9uoyducyXxQBD5zK09K_cYxk"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="colife-17952.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="colife-17952"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="colife-17952.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="999113569090"
NEXT_PUBLIC_FIREBASE_APP_ID="1:999113569090:web:82366fe7d6497ca925cedb"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-58MW23DDSK"

# ─── Razorpay ──────────────────────────────────────────────────────────────────
# From https://dashboard.razorpay.com/app/keys
# Server-side SDK auth + returned to frontend for Razorpay checkout
RAZORPAY_KEY_ID="rzp_test_SQUPmCYoArOzUb"
RAZORPAY_KEY_SECRET="AsvyxtVfRoll5SgBfbUtMLrd"

# Webhook secret — set under Razorpay Dashboard > Webhooks
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ─── App ───────────────────────────────────────────────────────────────────────
# Leave empty for local dev; set to https://your-app.vercel.app for production
NEXT_PUBLIC_API_URL=""

NODE_ENV="development"
