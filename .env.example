# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (used by Prisma)
DATABASE_URL="postgresql://colife:your_password@localhost:5433/colife_db"

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Random 32-byte secret for signing JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret"

# ─── Razorpay ──────────────────────────────────────────────────────────────────
# Live keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for staging, rzp_live_* for production
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Razorpay webhook secret (configure under Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ─── App ───────────────────────────────────────────────────────────────────────
# Public URL of the deployed app (used by the frontend API client)
NEXT_PUBLIC_API_URL=""

# Node environment — set to "production" in prod
NODE_ENV="development"

# ─── Cron ──────────────────────────────────────────────────────────────────────
# Optional: a secret passed as a header to secure the cron endpoint
# CRON_SECRET="your_cron_secret"

# ─── OTP (Development only) ────────────────────────────────────────────────────
# In development any 4-6 digit code is accepted.
# Set this only for automated integration tests in CI to bypass OTP:
# OTP_BYPASS_CODE="123456"
